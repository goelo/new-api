/* ==================== 暖色主题 — 覆盖 Semi Design 主色 ==================== */
/* 将 Semi 默认蓝色主色替换为与首页一致的暖棕色 #c4956a */
body {
  --semi-color-primary: #c4956a;
  --semi-color-primary-hover: #b8855a;
  --semi-color-primary-active: #a8754a;
  --semi-color-primary-disabled: #d4b598;
  --semi-color-primary-light-default: rgba(196, 149, 106, 0.08);
  --semi-color-primary-light-hover: rgba(196, 149, 106, 0.15);
  --semi-color-primary-light-active: rgba(196, 149, 106, 0.22);
  --semi-color-link: #c4956a;
  --semi-color-link-hover: #b8855a;
  --semi-color-link-active: #a8754a;
  --semi-color-link-visited: #a8754a;
  --semi-color-focus-border: rgba(196, 149, 106, 0.6);
}

/* 暗色模式下保持暖色但稍微提亮以保证可读性 */
body[theme-mode="dark"] {
  --semi-color-primary: #d4a87a;
  --semi-color-primary-hover: #c89868;
  --semi-color-primary-active: #bc8858;
  --semi-color-primary-disabled: #8a7560;
  --semi-color-primary-light-default: rgba(212, 168, 122, 0.12);
  --semi-color-primary-light-hover: rgba(212, 168, 122, 0.2);
  --semi-color-primary-light-active: rgba(212, 168, 122, 0.28);
  --semi-color-link: #d4a87a;
  --semi-color-link-hover: #c89868;
  --semi-color-link-active: #bc8858;
  --semi-color-link-visited: #bc8858;
  --semi-color-focus-border: rgba(212, 168, 122, 0.5);
}


/* ==================== FlashAPI Homepage Styles ==================== */

/* CSS Variables - derouter.ai 暖色调风格 (Default) */
:root {
  --flash-cyan: #c4956a;  /* 橙棕色 - 主强调色 */
  --flash-cyan-light: #c4956a;  /* 橙棕色 */
  --flash-blue: #6b6358;  /* 灰棕色 - 次要色 */
  --flash-bg-deep: #faf8f5;  /* 米白色背景 */
  --flash-bg-card: #ffffff;  /* 纯白卡片 */
  --flash-border: #f0ece4;  /* 浅米色边框 */
  --flash-text-primary: #2c2c2c;  /* 深灰黑标题 */
  --flash-text-muted: #6b6358;  /* 灰棕色文字 */
  --flash-text-dim: #9a9080;  /* 浅灰棕 */
  --flash-glow: rgba(196, 149, 106, 0.15);  /* 橙棕色光晕 */
  --flash-bg-code: #f0ece4;  /* 浅米色代码背景 */
  --flash-header-bg: rgba(250, 248, 245, 0.85);  /* 半透明米白 */
}

/* CSS Variables - Dark Mode Override (保留深色模式支持) */
body[theme-mode="dark"] {
  --flash-cyan: #c4956a;
  --flash-cyan-light: #c4956a;
  --flash-blue: #6b6358;
  --flash-bg-deep: #1a1a1a;
  --flash-bg-card: #2a2a2a;
  --flash-border: #3a3a3a;
  --flash-text-primary: #e2e8f0;
  --flash-text-muted: #9a9080;
  --flash-text-dim: #6b6358;
  --flash-glow: rgba(196, 149, 106, 0.2);
  --flash-bg-code: #1f1f1f;
  --flash-header-bg: rgba(26, 26, 26, 0.85);
}

/* Font Scoping */
.flash-home,
.flash-header,
.flash-footer {
  font-family: 'Outfit', system-ui, -apple-system, sans-serif;
}

.flash-home code,
.flash-home .mono {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
}

/* Background Effects */
.flash-home {
  position: relative;
  background: var(--flash-bg-deep);
  min-height: calc(100vh - 64px);
}

.flash-bg-grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(6,182,212,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(6,182,212,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
  z-index: 0;
}

body:not([theme-mode="dark"]) .flash-bg-grid {
  background-image:
    linear-gradient(rgba(6,182,212,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(6,182,212,0.02) 1px, transparent 1px);
}

.flash-bg-glow {
  position: fixed;
  top: -200px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse, rgba(6,182,212,0.08) 0%, rgba(59,130,246,0.04) 40%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

body:not([theme-mode="dark"]) .flash-bg-glow {
  background: radial-gradient(ellipse, rgba(6,182,212,0.04) 0%, rgba(59,130,246,0.02) 40%, transparent 70%);
}

/* Bento Grid Layout */
.flash-bento {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 32px 60px;
}

.flash-card {
  background: var(--flash-bg-card);
  border: 1px solid var(--flash-border);
  border-radius: 16px;
  padding: 24px;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0;
  transform: translateY(30px);
}

.flash-card.span-2 {
  grid-column: span 2;
}

.flash-card.span-3 {
  grid-column: span 3;
}

.flash-card:hover {
  border-color: rgba(6,182,212,0.4);
  box-shadow: 0 0 30px rgba(6,182,212,0.08);
  transform: translateY(-2px);
}

.flash-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--flash-cyan), transparent);
  opacity: 0;
  transition: opacity 0.4s;
}

.flash-card:hover::before {
  opacity: 0.5;
}

/* Animations */
@keyframes flash-card-in {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.flash-card:nth-child(1) {
  animation: flash-card-in 0.6s 0.1s ease-out forwards;
}

.flash-card:nth-child(2) {
  animation: flash-card-in 0.6s 0.2s ease-out forwards;
}

.flash-card:nth-child(3) {
  animation: flash-card-in 0.6s 0.3s ease-out forwards;
}

.flash-card:nth-child(4) {
  animation: flash-card-in 0.6s 0.4s ease-out forwards;
}

.flash-card:nth-child(5) {
  animation: flash-card-in 0.6s 0.5s ease-out forwards;
}

.flash-card:nth-child(6) {
  animation: flash-card-in 0.6s 0.6s ease-out forwards;
}

@keyframes flash-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}

@keyframes flash-blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

@keyframes flash-speed-pulse {
  0%, 100% {
    width: 12%;
    opacity: 0.8;
  }
  50% {
    width: 18%;
    opacity: 1;
  }
}

/* Logo Icon Styles */
.flash-logo-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--flash-cyan), var(--flash-blue));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20px rgba(6,182,212,0.3);
  position: relative;
  overflow: hidden;
  color: white;
}

.flash-logo-icon svg {
  width: 18px;
  height: 18px;
  position: relative;
  z-index: 1;
}

.flash-logo-icon::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
  animation: sweep-shine 3s ease-in-out infinite;
}

/* Header Styles */
.flash-header {
  background: var(--flash-header-bg) !important;
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--flash-border);
}

.flash-header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--flash-cyan), transparent);
  opacity: 0.3;
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .flash-card {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .flash-card:hover {
    transform: none;
  }

  .flash-pulse,
  .flash-blink,
  .flash-speed-bar-fill,
  .flash-logo-icon::after {
    animation: none !important;
  }
}

/* Responsive - Mobile */
@media (max-width: 767px) {
  .flash-bento {
    grid-template-columns: 1fr;
    padding: 0 16px 40px;
  }

  .flash-card {
    padding: 16px;
  }

  .flash-card.span-2,
  .flash-card.span-3 {
    grid-column: span 1;
  }
}

/* Responsive - Tablet */
@media (min-width: 768px) and (max-width: 1023px) {
  .flash-bento {
    grid-template-columns: repeat(2, 1fr);
  }

  .flash-card.span-3 {
    grid-column: span 2;
  }
}

/*
 * 暖色主题覆盖 — 通过 nginx 注入到官方 new-api 前端
 * 将 Semi Design 默认蓝色主色替换为与自定义首页一致的暖棕色 #c4956a
 */

/* ==================== Semi Design 主色覆盖 ==================== */
body {
  --semi-color-primary: #c4956a !important;
  --semi-color-primary-hover: #b8855a !important;
  --semi-color-primary-active: #a8754a !important;
  --semi-color-primary-disabled: #d4b598 !important;
  --semi-color-primary-light-default: rgba(196, 149, 106, 0.08) !important;
  --semi-color-primary-light-hover: rgba(196, 149, 106, 0.15) !important;
  --semi-color-primary-light-active: rgba(196, 149, 106, 0.22) !important;
  --semi-color-link: #c4956a !important;
  --semi-color-link-hover: #b8855a !important;
  --semi-color-link-active: #a8754a !important;
  --semi-color-link-visited: #a8754a !important;
  --semi-color-focus-border: rgba(196, 149, 106, 0.6) !important;
}

/* 暗色模式 */
body[theme-mode="dark"] {
  --semi-color-primary: #d4a87a !important;
  --semi-color-primary-hover: #c89868 !important;
  --semi-color-primary-active: #bc8858 !important;
  --semi-color-primary-disabled: #8a7560 !important;
  --semi-color-primary-light-default: rgba(212, 168, 122, 0.12) !important;
  --semi-color-primary-light-hover: rgba(212, 168, 122, 0.2) !important;
  --semi-color-primary-light-active: rgba(212, 168, 122, 0.28) !important;
  --semi-color-link: #d4a87a !important;
  --semi-color-link-hover: #c89868 !important;
  --semi-color-link-active: #bc8858 !important;
  --semi-color-link-visited: #bc8858 !important;
  --semi-color-focus-border: rgba(212, 168, 122, 0.5) !important;
}

/* ==================== 登录/注册页面背景 ==================== */
/* 把冷灰背景改为暖米白 */
.bg-gray-100 {
  background-color: #faf8f5 !important;
}

/* ==================== 模糊晕染球颜色 ==================== */
.blur-ball-indigo {
  background: #c4956a !important;
}

.blur-ball-teal {
  background: #d4a87a !important;
}

/* ==================== 蓝色链接改为暖棕色 ==================== */
.text-blue-600 {
  color: #c4956a !important;
}

a.text-blue-600:hover,
.hover\:text-blue-800:hover {
  color: #a8754a !important;
}

/* ==================== Header 统一暖色风格 ==================== */
/* 让所有页面的 header 都使用暖色背景，不只是首页 */
header.sticky {
  background: rgba(250, 248, 245, 0.85) !important;
  backdrop-filter: blur(20px);
  border-bottom: 1px solid #f0ece4;
}

body[theme-mode="dark"] header.sticky {
  background: rgba(26, 26, 26, 0.85) !important;
  border-bottom: 1px solid #3a3a3a;
}

/* ==================== 登录/注册页面 — 完整暖色风格 ==================== */

/* 邮箱登录按钮：冷黑 → 暖棕 */
.bg-black {
  background-color: #c4956a !important;
}
.hover\:bg-gray-800:hover {
  background-color: #b8855a !important;
}

/* OAuth 按钮边框/悬停 → 暖色调 */
.border-gray-200 {
  border-color: #e8ddd0 !important;
}
.hover\:bg-gray-50:hover {
  background-color: rgba(196, 149, 106, 0.06) !important;
}

/* 标题文字 → 暖灰 */
.\!text-gray-800,
.text-gray-800 {
  color: #5a4a3a !important;
}
html[class*="dark"] .\!text-gray-800,
body[theme-mode="dark"] .\!text-gray-800,
body[theme-mode="dark"] .text-gray-800 {
  color: #e0d6cc !important;
}

/* 协议文字 → 暖灰 */
.text-gray-600 {
  color: #8a7a6a !important;
}

/* 分割线 → 暖色调 */
.bg-gray-100 .semi-divider {
  border-color: #e8ddd0;
}

/* 2FA 成功图标 → 暖色 */
.bg-green-100 {
  background-color: rgba(196, 149, 106, 0.15) !important;
}
.text-green-600 {
  color: #c4956a !important;
}
body[theme-mode="dark"] .bg-green-900 {
  background-color: rgba(196, 149, 106, 0.2) !important;
}
body[theme-mode="dark"] .text-green-400 {
  color: #d4a87a !important;
}

/* Card 卡片 → 暖白底色 + 柔和阴影 */
.bg-gray-100 .semi-card {
  background: #fffdf9 !important;
  box-shadow: 0 4px 24px rgba(180, 140, 100, 0.08) !important;
}
body[theme-mode="dark"] .semi-card {
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3) !important;
}

/* ==================== 侧边栏选中项暖色 ==================== */
.sidebar-nav-item:hover {
  background-color: rgba(196, 149, 106, 0.08) !important;
  color: #c4956a !important;
}

.sidebar-nav-item-selected {
  background-color: rgba(196, 149, 106, 0.12) !important;
  color: #c4956a !important;
}

/* ==================== 注册页面额外覆盖 ==================== */
/* 注册页同样使用暖色背景 */
.bg-gray-100 .blur-ball-indigo,
.bg-gray-100 .blur-ball-teal {
  opacity: 0.3;
}
